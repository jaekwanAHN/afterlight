    "format": "prettier --write .",
    "perf": "vitest run tests/performance.test.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
